# Environment
PORT=5000

# JWT
JWT_SECRET_KEY=rallyriot-super-secret-dev-key-2025
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database
DB_STORAGE=./data/rallyriot.sqlite

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# AI Chat Assistant
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Email notifications (optional — leave blank to disable, app works without it)
# Use any SMTP provider: Gmail, SendGrid, Mailgun, etc.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rallyriot.com
